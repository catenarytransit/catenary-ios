        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catenary verwendet dies, um die App-Nutzung mit Google Analytics zu messen, wodurch deine Aktivität mit anderen Apps und Websites verknüpft werden kann."
