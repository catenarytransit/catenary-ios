      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catenary uses this to measure app usage with Google Analytics, which may link your activity across other apps and websites."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catenary използва това за измерване на използването на приложението чрез Google Analytics, който може да свърже дейността ви с други приложения и уебсайтове."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catenary to používá k měření využití aplikace pomocí Google Analytics, což může propojit vaši aktivitu s dalšími aplikacemi a webovými stránkami."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catenary bruger dette til at måle appforbrug via Google Analytics, som kan forbinde din aktivitet på tværs af andre apps og websites."
