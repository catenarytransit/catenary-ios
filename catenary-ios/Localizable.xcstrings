    "Show a live countdown for rail departures less than one hour away." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показвай обратно броене в реално време за железопътни заминавания след по-малко от един час."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazovat živý odpočet u vlakových odjezdů za méně než jednu hodinu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis en live-nedtælling for togafgange inden for en time."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Bahnabfahrten innerhalb der nächsten Stunde einen Live-Countdown anzeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση ζωντανής αντίστροφης μέτρησης για αναχωρήσεις τρένων σε λιγότερο από μία ώρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show a live countdown for rail departures less than one hour away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar una cuenta atrás en directo para las salidas ferroviarias dentro de una hora."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä reaaliaikainen lähtölaskenta alle tunnin päässä oleville junalähdöille."
          }
