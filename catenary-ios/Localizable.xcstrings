    "Tap to choose a date and time, or drag horizontally to change the time" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докоснете, за да изберете дата и час, или плъзнете хоризонтално, за да промените часа"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím vyberte datum a čas nebo vodorovným tažením změňte čas"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk for at vælge dato og tid, eller træk vandret for at ændre tiden"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen, um Datum und Uhrzeit auszuwählen, oder horizontal ziehen, um die Uhrzeit zu ändern"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε για επιλογή ημερομηνίας και ώρας ή σύρετε οριζόντια για αλλαγή της ώρας"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap to choose a date and time, or drag horizontally to change the time"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para elegir una fecha y hora, o arrastra horizontalmente para cambiar la hora"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse päivämäärä ja aika napauttamalla tai muuta aikaa vetämällä vaakasuunnassa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour choisir une date et une heure, ou faites glisser horizontalement pour modifier l’heure"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppintson a dátum és idő kiválasztásához, vagy húzza vízszintesen az idő módosításához"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per scegliere data e ora oppure trascina orizzontalmente per cambiare l’ora"
          }
        },
