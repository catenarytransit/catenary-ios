    "Allow location access, or use the current map center to see nearby departures." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешете достъп до местоположението или използвайте текущия център на картата, за да видите близките заминавания."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte přístup k poloze nebo použijte aktuální střed mapy pro zobrazení odjezdů v okolí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad adgang til placering, eller brug kortets aktuelle centrum for at se afgange i nærheden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standortzugriff erlauben oder die aktuelle Kartenmitte verwenden, um Abfahrten in der Nähe anzuzeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε την πρόσβαση στην τοποθεσία ή χρησιμοποιήστε το τρέχον κέντρο του χάρτη για να δείτε κοντινές αναχωρήσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow location access, or use the current map center to see nearby departures."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a la ubicación o usa el centro actual del mapa para ver salidas cercanas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli sijainnin käyttö tai käytä kartan nykyistä keskipistettä nähdäksesi lähdöt lähellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’accès à la position ou utilisez le centre actuel de la carte pour voir les départs à proximité."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engedélyezze a helyhozzáférést, vagy használja a térkép jelenlegi közepét a közeli indulások megtekintéséhez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti l’accesso alla posizione oppure usa il centro attuale della mappa per vedere le partenze vicine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報へのアクセスを許可するか、現在の地図の中心を使って周辺の出発情報を表示してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치 접근을 허용하거나 현재 지도 중심을 사용하여 주변 출발 정보를 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillat posisjonstilgang, eller bruk kartets nåværende sentrum for å se avganger i nærheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta locatietoegang toe of gebruik het huidige midden van de kaart om vertrekken in de buurt te bekijken."
          }
        },
        "oc" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorizatz l’accès a la posicion o utilizatz lo centre actual de la mapa per veire las partenças a proximitat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól na dostęp do lokalizacji albo użyj bieżącego środka mapy, aby zobaczyć pobliskie odjazdy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso à localização ou use o centro atual do mapa para ver partidas próximas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permiteți accesul la locație sau folosiți centrul actual al hărții pentru a vedea plecările din apropiere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к местоположению или используйте текущий центр карты, чтобы увидеть ближайшие отправления."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoľte prístup k polohe alebo použite aktuálny stred mapy na zobrazenie odchodov v okolí."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt platsåtkomst eller använd kartans nuvarande mittpunkt för att se avgångar i närheten."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозвольте доступ до місцезнаходження або використайте поточний центр мапи, щоб переглянути найближчі відправлення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请允许访问位置，或使用当前地图中心查看附近出发班次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請允許取用位置，或使用目前的地圖中心查看附近出發班次。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請允許取用位置，或使用目前的地圖中心查看附近班次。"
          }
        }
      }
    },
